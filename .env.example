# Copy to .env and fill in. .env is git-ignored.
DEBUG=1
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Required when DEBUG=0 - there is no wildcard default in production, so an unset value
# makes Django answer 400 to every request. Comma-separated.
ALLOWED_HOSTS=*
# The one header trusted for the caller's IP (per-IP lookup throttle). Behind the Cloudflare
# tunnel that is CF-Connecting-IP, which the edge overwrites; X-Forwarded-For is never used
# because Cloudflare appends to it. Set empty when no proxy fronts the app.
CLIENT_IP_HEADER=CF-Connecting-IP
# Refuse a scan that would fetch more killmail rows than this (they are aggregated in Python).
MAX_SCAN_ROWS=100000
# Read-only connection to the shared eve DB (killmails + sde), served by the eve-dev Postgres.
DATABASE_URL=postgres://lscan:lscan@127.0.0.1:55432/eve?sslmode=disable
# Cache for ESI responses (the shared eve-dev Redis; db 1 is lscan's, db 0 is helion's).
REDIS_URL=redis://127.0.0.1:56379/1
# CCP wants real contact info in the User-Agent - put YOUR address here before deploying.
ESI_USER_AGENT=lscan/0.1 (+https://lscan.entropiadev.com; lscan@entropiadev.com)
# Seconds a Postgres connection is reused across requests (0 = reconnect every request).
CONN_MAX_AGE=60
# Level for the intel.* loggers; WARNING if the per-request ESI log is too chatty.
LOG_LEVEL=INFO
