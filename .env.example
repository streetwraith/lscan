# Copy to .env and fill in. .env is git-ignored.
DEBUG=1
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=*
# Matches docker-compose.yml (local dev Postgres on 127.0.0.1:55433)
DATABASE_URL=postgres://lscan:lscan@127.0.0.1:55433/lscan
